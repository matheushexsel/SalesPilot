<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sp_order_form" model="ir.ui.view">
        <field name="name">sp.order.form</field>
        <field name="model">sp.order</field>
        <field name="arch" type="xml">
            <form string="Pedido">
                <header>
                    <button name="action_confirm" type="object" string="Confirmar" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_prepare" type="object" string="Em preparo" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_deliver" type="object" string="Saiu para entrega" class="btn-primary" invisible="state != 'preparing'"/>
                    <button name="action_delivered" type="object" string="Entregue" class="btn-primary" invisible="state != 'delivering'"/>
                    <button name="action_set_paid" type="object" string="Marcar como pago" invisible="payment_status == 'paid' or state == 'cancelled'"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="state in ('delivered', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Voltar a rascunho" invisible="state not in ('cancelled', 'confirmed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,preparing,delivering,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="restaurant_id" options="{'no_create': True}"/>
                            <field name="partner_id" context="{'default_sp_restaurant_id': restaurant_id, 'default_sp_is_customer': True}"/>
                            <field name="date_order"/>
                            <field name="channel"/>
                            <field name="delivery_address"/>
                        </group>
                        <group>
                            <field name="payment_method"/>
                            <field name="payment_status" widget="badge" decoration-success="payment_status == 'paid'" decoration-warning="payment_status == 'pending'"/>
                            <field name="coupon_code"/>
                            <field name="campaign_id" readonly="1"/>
                            <field name="automation_id" readonly="1"/>
                            <field name="from_menu" readonly="1"/>
                            <field name="tracked" readonly="1"/>
                            <field name="attributed" readonly="1"/>
                            <field name="recommendation_accepted" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Itens">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="qty"/>
                                    <field name="price_unit" widget="monetary"/>
                                    <field name="notes"/>
                                    <field name="recommended"/>
                                    <field name="price_subtotal" widget="monetary" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_subtotal" widget="monetary"/>
                                <field name="delivery_fee" widget="monetary"/>
                                <field name="discount_amount" widget="monetary"/>
                                <field name="amount_total" widget="monetary" class="oe_subtotal_footer_separator"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </page>
                        <page string="Observações">
                            <field name="customer_notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sp_order_list" model="ir.ui.view">
        <field name="name">sp.order.list</field>
        <field name="model">sp.order</field>
        <field name="arch" type="xml">
            <list string="Pedidos" decoration-muted="state == 'cancelled'" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="date_order"/>
                <field name="restaurant_id" optional="show"/>
                <field name="partner_id"/>
                <field name="channel"/>
                <field name="item_summary"/>
                <field name="amount_total" widget="monetary" sum="Total"/>
                <field name="payment_method" optional="hide"/>
                <field name="payment_status" widget="badge" optional="show" decoration-success="payment_status == 'paid'" decoration-warning="payment_status == 'pending'"/>
                <field name="campaign_id" optional="show"/>
                <field name="tracked" optional="hide"/>
                <field name="attributed" optional="hide"/>
                <field name="recommendation_accepted" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'delivered'" decoration-info="state in ('confirmed','preparing','delivering')" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_sp_order_kanban" model="ir.ui.view">
        <field name="name">sp.order.kanban</field>
        <field name="model">sp.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div><strong><field name="name"/></strong> · <field name="partner_id"/></div>
                        <div class="small text-muted"><field name="date_order"/> · <field name="channel"/></div>
                        <div class="small"><field name="item_summary"/></div>
                        <div><strong><field name="amount_total" widget="monetary"/></strong>
                            <span t-if="record.attributed.raw_value" class="badge text-bg-success ms-1">campanha</span>
                        </div>
                        <field name="attributed" invisible="1"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sp_order_search" model="ir.ui.view">
        <field name="name">sp.order.search</field>
        <field name="model">sp.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="restaurant_id"/>
                <field name="campaign_id"/>
                <filter name="today" string="Hoje" domain="[('date_order', '>=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="open" string="Em andamento" domain="[('state', 'in', ('confirmed', 'preparing', 'delivering'))]"/>
                <filter name="delivered" string="Entregues" domain="[('state', '=', 'delivered')]"/>
                <separator/>
                <filter name="tracked" string="Jornada rastreada" domain="[('tracked', '=', True)]"/>
                <filter name="attributed" string="Atribuídos a campanha" domain="[('attributed', '=', True)]"/>
                <filter name="recommended" string="Com recomendação aceita" domain="[('recommendation_accepted', '=', True)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_channel" string="Canal" context="{'group_by': 'channel'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_day" string="Dia" context="{'group_by': 'date_order:day'}"/>
                    <filter name="group_week" string="Semana" context="{'group_by': 'date_order:week'}"/>
                    <filter name="group_restaurant" string="Restaurante" context="{'group_by': 'restaurant_id'}"/>
                    <filter name="group_campaign" string="Campanha" context="{'group_by': 'campaign_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_sp_order_graph" model="ir.ui.view">
        <field name="name">sp.order.graph</field>
        <field name="model">sp.order</field>
        <field name="arch" type="xml">
            <graph string="Receita" type="line">
                <field name="date_order" interval="week"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_sp_order_pivot" model="ir.ui.view">
        <field name="name">sp.order.pivot</field>
        <field name="model">sp.order</field>
        <field name="arch" type="xml">
            <pivot string="Pedidos">
                <field name="weekday" type="row"/>
                <field name="hour" type="col"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_sp_order_calendar" model="ir.ui.view">
        <field name="name">sp.order.calendar</field>
        <field name="model">sp.order</field>
        <field name="arch" type="xml">
            <calendar string="Pedidos" date_start="date_order" color="channel" mode="week">
                <field name="partner_id"/>
                <field name="amount_total"/>
            </calendar>
        </field>
    </record>

    <record id="action_sp_orders" model="ir.actions.act_window">
        <field name="name">Pedidos</field>
        <field name="res_model">sp.order</field>
        <field name="view_mode">list,kanban,form,graph,pivot,calendar</field>
        <field name="search_view_id" ref="view_sp_order_search"/>
        <field name="context">{'search_default_group_restaurant': 0}</field>
    </record>

    <record id="view_sp_order_line_pivot" model="ir.ui.view">
        <field name="name">sp.order.line.pivot</field>
        <field name="model">sp.order.line</field>
        <field name="arch" type="xml">
            <pivot string="Itens vendidos">
                <field name="product_tmpl_id" type="row"/>
                <field name="qty" type="measure"/>
                <field name="price_subtotal" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_sp_order_line_graph" model="ir.ui.view">
        <field name="name">sp.order.line.graph</field>
        <field name="model">sp.order.line</field>
        <field name="arch" type="xml">
            <graph string="Itens vendidos" type="bar">
                <field name="product_tmpl_id"/>
                <field name="qty" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_sp_order_line_list" model="ir.ui.view">
        <field name="name">sp.order.line.list</field>
        <field name="model">sp.order.line</field>
        <field name="arch" type="xml">
            <list string="Itens vendidos" create="false">
                <field name="date_order"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="qty" sum="Qtd"/>
                <field name="price_subtotal" widget="monetary" sum="Total"/>
                <field name="recommended"/>
            </list>
        </field>
    </record>
    <record id="action_sp_order_lines" model="ir.actions.act_window">
        <field name="name">Itens vendidos</field>
        <field name="res_model">sp.order.line</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="domain">[('state', 'in', ('confirmed', 'preparing', 'delivering', 'delivered'))]</field>
    </record>
</odoo>
