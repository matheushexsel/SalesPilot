<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sp_message_list" model="ir.ui.view">
        <field name="name">sp.message.list</field>
        <field name="model">sp.message</field>
        <field name="arch" type="xml">
            <list string="Caixa de saída" create="false" decoration-muted="state in ('skipped','failed')" decoration-success="clicked">
                <field name="create_date" string="Data"/>
                <field name="restaurant_id" optional="show"/>
                <field name="partner_id"/>
                <field name="channel"/>
                <field name="to"/>
                <field name="campaign_id" optional="show"/>
                <field name="automation_id" optional="show"/>
                <field name="body"/>
                <field name="provider" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state in ('delivered','read')" decoration-danger="state == 'failed'" decoration-warning="state == 'skipped'"/>
                <field name="clicked"/>
                <field name="order_count"/>
                <field name="error" optional="hide"/>
                <button name="action_open_tracking" type="object" icon="fa-external-link" title="Abrir link rastreado (simula o clique do cliente)"/>
            </list>
        </field>
    </record>

    <record id="view_sp_message_form" model="ir.ui.view">
        <field name="name">sp.message.form</field>
        <field name="model">sp.message</field>
        <field name="arch" type="xml">
            <form string="Mensagem" create="false">
                <header>
                    <button name="action_retry" type="object" string="Reenviar" invisible="state not in ('failed', 'skipped')"/>
                    <button name="action_open_tracking" type="object" string="Abrir link rastreado" icon="fa-external-link"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="restaurant_id"/>
                            <field name="partner_id"/>
                            <field name="channel"/>
                            <field name="to"/>
                            <field name="provider"/>
                            <field name="provider_ref"/>
                            <field name="error"/>
                        </group>
                        <group>
                            <field name="campaign_id"/>
                            <field name="automation_id"/>
                            <field name="date_sent"/>
                            <field name="clicked"/>
                            <field name="date_clicked"/>
                            <field name="coupon_code"/>
                            <field name="tracking_url" widget="url"/>
                        </group>
                    </group>
                    <div class="o_sp_bubble p-3 rounded" style="background:#DCF8C6; max-width: 520px; white-space: pre-wrap;">
                        <field name="body" nolabel="1" readonly="1"/>
                    </div>
                    <separator string="Pedidos gerados"/>
                    <field name="order_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="date_order"/>
                            <field name="amount_total" widget="monetary"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sp_message_search" model="ir.ui.view">
        <field name="name">sp.message.search</field>
        <field name="model">sp.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="body"/>
                <field name="campaign_id"/>
                <filter name="clicked" string="Com clique" domain="[('clicked', '=', True)]"/>
                <filter name="failed" string="Falhas / ignoradas" domain="[('state', 'in', ('failed', 'skipped'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_campaign" string="Campanha" context="{'group_by': 'campaign_id'}"/>
                    <filter name="group_automation" string="Régua" context="{'group_by': 'automation_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_day" string="Dia" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sp_messages" model="ir.actions.act_window">
        <field name="name">Caixa de saída (WhatsApp / SMS)</field>
        <field name="res_model">sp.message</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sp_message_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nenhuma mensagem ainda</p>
            <p>Aqui ficam todas as mensagens geradas por campanhas e réguas. No piloto o provedor é "simulação":
               nada é enviado de verdade, mas o link rastreado funciona e atribui pedidos.</p>
        </field>
    </record>
</odoo>
