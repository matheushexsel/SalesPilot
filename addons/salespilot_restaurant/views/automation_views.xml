<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sp_automation_form" model="ir.ui.view">
        <field name="name">sp.automation.form</field>
        <field name="model">sp.automation</field>
        <field name="arch" type="xml">
            <form string="Régua automática">
                <header>
                    <button name="action_run_now" type="object" string="Executar agora" class="btn-primary"
                            invisible="trigger in ('welcome', 'post_purchase')"
                            confirm="Disparar a régua para todos os clientes elegíveis agora?"/>
                    <button name="action_preview_candidates" type="object" string="Ver elegíveis agora"
                            invisible="trigger in ('welcome', 'post_purchase')"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_messages" type="object" class="oe_stat_button" icon="fa-paper-plane">
                            <field name="sent_count" widget="statinfo" string="Enviadas"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-shopping-bag" disabled="1">
                            <field name="order_count" widget="statinfo" string="Pedidos"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-money" disabled="1">
                            <field name="attributed_revenue" widget="statinfo" string="Receita"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Inativa" bg_color="text-bg-secondary" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ex.: Red flag - sumiu há 2 semanas"/></h1>
                    </div>
                    <group>
                        <group string="Gatilho">
                            <field name="restaurant_id" options="{'no_create': True}"/>
                            <field name="trigger"/>
                            <field name="active"/>
                            <field name="channel" widget="radio" options="{'horizontal': true}"/>
                            <field name="send_message"/>
                            <field name="create_alert"/>
                            <field name="last_run"/>
                        </group>
                        <group string="Parâmetros">
                            <field name="churn_level" invisible="trigger != 'churn'"/>
                            <field name="days_before" invisible="trigger != 'birthday'"/>
                            <field name="hours_before" invisible="trigger != 'habit'"/>
                            <field name="days_since_min" invisible="trigger != 'winback'"/>
                            <field name="days_since_max" invisible="trigger != 'winback'"/>
                            <field name="min_orders"/>
                            <field name="segment_codes" placeholder="vazio = todos"/>
                            <field name="send_hour_start"/>
                            <field name="send_hour_end"/>
                            <field name="cooldown_days"/>
                        </group>
                        <group string="Oferta">
                            <field name="coupon_code"/>
                            <field name="discount_pct"/>
                            <field name="discount_value"/>
                        </group>
                    </group>
                    <separator string="Mensagem"/>
                    <field name="message_template"/>
                    <p class="text-muted">Variáveis: {nome} {produto_favorito} {cupom} {desconto} {link} {restaurante} {dia_semana} {dias_sem_pedir}.</p>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sp_automation_list" model="ir.ui.view">
        <field name="name">sp.automation.list</field>
        <field name="model">sp.automation</field>
        <field name="arch" type="xml">
            <list string="Réguas">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="restaurant_id" optional="show"/>
                <field name="trigger"/>
                <field name="channel"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="sent_count"/>
                <field name="order_count"/>
                <field name="attributed_revenue" widget="monetary" sum="Receita"/>
                <field name="last_run"/>
            </list>
        </field>
    </record>

    <record id="action_sp_automations" model="ir.actions.act_window">
        <field name="name">Réguas automáticas</field>
        <field name="res_model">sp.automation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crie a primeira régua</p>
            <p>Réguas rodam sozinhas: aniversário, lembrete no dia/horário habitual, red flag de recorrência,
               boas-vindas após o 1º pedido e pesquisa pós-compra.</p>
        </field>
    </record>
</odoo>
