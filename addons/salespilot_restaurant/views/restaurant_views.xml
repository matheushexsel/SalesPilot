<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sp_restaurant_form" model="ir.ui.view">
        <field name="name">sp.restaurant.form</field>
        <field name="model">sp.restaurant</field>
        <field name="arch" type="xml">
            <form string="Restaurante">
                <header>
                    <button name="action_recompute_rfv" type="object" string="Recalcular RFV e insights" class="btn-primary"/>
                    <button name="action_open_dashboard" type="object" string="Abrir dashboard"/>
                    <button name="action_open_menu" type="object" string="Ver cardápio digital" icon="fa-external-link"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_customers" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="customer_count" widget="statinfo" string="Clientes"/>
                        </button>
                        <button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-shopping-bag">
                            <field name="order_count" widget="statinfo" string="Pedidos"/>
                        </button>
                        <button name="action_view_products" type="object" class="oe_stat_button" icon="fa-cutlery">
                            <field name="product_count" widget="statinfo" string="Itens"/>
                        </button>
                        <button name="action_view_campaigns" type="object" class="oe_stat_button" icon="fa-bullhorn">
                            <field name="campaign_count" widget="statinfo" string="Campanhas"/>
                        </button>
                        <button name="action_view_alerts" type="object" class="oe_stat_button" icon="fa-flag">
                            <field name="open_alert_count" widget="statinfo" string="Alertas"/>
                        </button>
                    </div>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nome do restaurante"/></h1>
                        <field name="tagline" placeholder="Frase de apresentação do cardápio"/>
                    </div>
                    <group>
                        <group string="Identificação">
                            <field name="segment"/>
                            <field name="slug" readonly="not is_sp_admin"/>
                            <field name="is_sp_admin" invisible="1"/>
                            <field name="menu_url" widget="url"/>
                            <field name="color_primary" widget="color"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Contato e operação">
                            <field name="whatsapp"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="street"/>
                            <field name="city"/>
                            <field name="state_code"/>
                            <field name="opening_hours"/>
                        </group>
                        <group string="Delivery">
                            <field name="delivery_fee"/>
                            <field name="min_order"/>
                            <field name="avg_prep_minutes"/>
                            <field name="revenue_30d" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Plano SalesPilot" groups="salespilot_restaurant.group_sp_admin">
                            <field name="plan_monthly_fee"/>
                            <field name="plan_success_fee_pct"/>
                            <field name="marketplace_fee_reference_pct"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Motor RFV e alertas">
                            <group>
                                <group>
                                    <field name="rfv_window_days"/>
                                    <field name="churn_warning_factor"/>
                                    <field name="churn_critical_factor"/>
                                    <field name="auto_message_cooldown_days"/>
                                </group>
                                <group>
                                    <field name="last_rfv_run"/>
                                </group>
                            </group>
                        </page>
                        <page string="Usuários com acesso" groups="salespilot_restaurant.group_sp_admin">
                            <field name="user_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sp_restaurant_list" model="ir.ui.view">
        <field name="name">sp.restaurant.list</field>
        <field name="model">sp.restaurant</field>
        <field name="arch" type="xml">
            <list string="Restaurantes">
                <field name="name"/>
                <field name="segment"/>
                <field name="city"/>
                <field name="customer_count"/>
                <field name="order_count"/>
                <field name="revenue_30d" widget="monetary" sum="Total"/>
                <field name="open_alert_count"/>
                <field name="last_rfv_run"/>
            </list>
        </field>
    </record>

    <record id="view_sp_restaurant_kanban" model="ir.ui.view">
        <field name="name">sp.restaurant.kanban</field>
        <field name="model">sp.restaurant</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex">
                            <field name="logo" widget="image" class="o_kanban_image me-2" options="{'size': [64, 64]}"/>
                            <div class="flex-grow-1">
                                <strong><field name="name"/></strong>
                                <div class="text-muted"><field name="segment"/> · <field name="city"/></div>
                                <div><field name="customer_count"/> clientes · <field name="order_count"/> pedidos</div>
                                <div>Receita 30d: <field name="revenue_30d" widget="monetary"/></div>
                                <div><span class="badge text-bg-warning"><field name="open_alert_count"/> alertas</span></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_sp_restaurant" model="ir.actions.act_window">
        <field name="name">Restaurantes</field>
        <field name="res_model">sp.restaurant</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cadastre o primeiro restaurante</p>
            <p>Cada restaurante tem seu cardápio digital, base de clientes, campanhas e réguas.</p>
        </field>
    </record>

    <record id="view_sp_menu_category_list" model="ir.ui.view">
        <field name="name">sp.menu.category.list</field>
        <field name="model">sp.menu.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="restaurant_id"/>
                <field name="product_count"/>
            </list>
        </field>
    </record>
    <record id="action_sp_menu_category" model="ir.actions.act_window">
        <field name="name">Categorias do cardápio</field>
        <field name="res_model">sp.menu.category</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
