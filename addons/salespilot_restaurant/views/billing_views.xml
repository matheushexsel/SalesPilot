<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sp_billing_form" model="ir.ui.view">
        <field name="name">sp.billing.period.form</field>
        <field name="model">sp.billing.period</field>
        <field name="arch" type="xml">
            <form string="Fatura SalesPilot">
                <header>
                    <button name="action_compute" type="object" string="Recalcular" invisible="state == 'paid'"/>
                    <button name="action_issue" type="object" string="Emitir" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_paid" type="object" string="Marcar como paga" invisible="state != 'issued'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Período">
                            <field name="restaurant_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Plano">
                            <field name="monthly_fee" widget="monetary"/>
                            <field name="success_fee_pct"/>
                            <field name="marketplace_pct"/>
                        </group>
                        <group string="Jornada rastreada">
                            <field name="orders_total"/>
                            <field name="revenue_total" widget="monetary"/>
                            <field name="orders_tracked"/>
                            <field name="tracked_revenue" widget="monetary"/>
                            <field name="attributed_revenue" widget="monetary"/>
                            <field name="recommendation_revenue" widget="monetary"/>
                            <field name="messages_sent"/>
                        </group>
                        <group string="Cobrança">
                            <field name="success_fee" widget="monetary"/>
                            <field name="total_due" widget="monetary" class="fw-bold"/>
                            <field name="effective_rate" widget="float" digits="[16,2]"/>
                            <field name="marketplace_reference_cost" widget="monetary"/>
                            <field name="savings" widget="monetary"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Observações"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_sp_billing_list" model="ir.ui.view">
        <field name="name">sp.billing.period.list</field>
        <field name="model">sp.billing.period</field>
        <field name="arch" type="xml">
            <list string="Faturas">
                <field name="restaurant_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="orders_tracked" sum="Pedidos"/>
                <field name="tracked_revenue" widget="monetary" sum="Receita rastreada"/>
                <field name="monthly_fee" widget="monetary"/>
                <field name="success_fee" widget="monetary" sum="Sucesso"/>
                <field name="total_due" widget="monetary" sum="Total"/>
                <field name="savings" widget="monetary" sum="Economia"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="action_sp_billing" model="ir.actions.act_window">
        <field name="name">Faturas (mensalidade + sucesso)</field>
        <field name="res_model">sp.billing.period</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
