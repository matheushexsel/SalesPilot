<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sp_send_message_wizard" model="ir.ui.view">
        <field name="name">sp.send.message.wizard.form</field>
        <field name="model">sp.send.message.wizard</field>
        <field name="arch" type="xml">
            <form string="Enviar mensagem">
                <group>
                    <group>
                        <field name="restaurant_id" options="{'no_create': True}"/>
                        <field name="partner_ids" widget="many2many_tags"/>
                        <field name="channel" widget="radio" options="{'horizontal': true}"/>
                        <field name="preset"/>
                    </group>
                    <group>
                        <field name="coupon_code"/>
                        <field name="discount_pct"/>
                        <field name="campaign_id" domain="[('restaurant_id', '=', restaurant_id)]"/>
                        <field name="alert_id" invisible="1"/>
                    </group>
                </group>
                <field name="body"/>
                <div class="p-3 rounded mt-2" style="background:#DCF8C6; white-space: pre-wrap;">
                    <field name="preview" nolabel="1" readonly="1"/>
                </div>
                <footer>
                    <button name="action_send" type="object" string="Enviar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_sp_send_message_wizard" model="ir.actions.act_window">
        <field name="name">Enviar mensagem</field>
        <field name="res_model">sp.send.message.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="context">{'default_partner_ids': active_ids}</field>
    </record>
</odoo>
