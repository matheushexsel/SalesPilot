<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_rfv_recompute" model="ir.cron">
            <field name="name">SalesPilot: recalcular RFV, insights e alertas</field>
            <field name="model_id" ref="model_sp_rfv_engine"/>
            <field name="state">code</field>
            <field name="code">model.cron_recompute_all()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_automations" model="ir.cron">
            <field name="name">SalesPilot: executar réguas automáticas</field>
            <field name="model_id" ref="model_sp_automation"/>
            <field name="state">code</field>
            <field name="code">model.cron_run()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_campaigns" model="ir.cron">
            <field name="name">SalesPilot: enviar campanhas agendadas</field>
            <field name="model_id" ref="model_sp_campaign"/>
            <field name="state">code</field>
            <field name="code">model.cron_send_scheduled()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_billing" model="ir.cron">
            <field name="name">SalesPilot: gerar fatura do mês anterior</field>
            <field name="model_id" ref="model_sp_billing_period"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_previous_month()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="param_message_provider" model="ir.config_parameter">
            <field name="key">salespilot.message_provider</field>
            <field name="value">simulation</field>
        </record>
    </data>
</odoo>
